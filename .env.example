# Environment template. Docker Compose reads .env; direct execution and systemd
# require exporting these variables or using EnvironmentFile respectively.
LISTEN_ADDR=:8082
API_PREFIX=/trade/api/v1
CORS_ORIGINS=*
LOG_LEVEL=info
REQUEST_TIMEOUT=12s
SHUTDOWN_TIMEOUT=15s
MAX_WS_CONNECTIONS=256
MAX_WS_SUBSCRIPTIONS=32

# Host mapping for Docker Compose (keep behind Nginx by default).
BIND_ADDR=127.0.0.1
PORT=8082
